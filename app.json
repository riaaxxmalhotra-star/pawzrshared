{
  "expo": {
    "name": "Pawzr",
    "slug": "pawzr",
    "owner": "riaaxxmalhotra",
    "version": "1.3.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": false,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFBF5"
    },
    "primaryColor": "#FFFBF5",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.pawzr.app",
      "buildNumber": "36",
      "usesAppleSignIn": true,
      "splash": {
        "image": "./assets/splash-icon.png",
        "resizeMode": "contain",
        "backgroundColor": "#FFFBF5",
        "tabletImage": "./assets/splash-icon.png"
      },
      "infoPlist": {
        "CFBundleURLTypes": [
          {
            "CFBundleURLSchemes": [
              "com.googleusercontent.apps.1094158533320-7fugh8bijpp1770uo21b0ubf8f36odp1"
            ]
          }
        ],
        "ITSAppUsesNonExemptEncryption": false,
        "NSLocationWhenInUseUsageDescription": "Pawzr uses your location to show nearby pet lovers and calculate distances.",
        "NSPhotoLibraryUsageDescription": "Pawzr needs access to your photo library to let you choose a profile picture for yourself or your pets. For example, you can select a photo of your pet to add to their profile."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFFBF5"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.pawzr.app",
      "versionCode": 70,
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "scheme": "pawzr",
    "extra": {
      "eas": {
        "projectId": "380a56f3-19c6-4d20-acca-42b5a7e3a349"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/380a56f3-19c6-4d20-acca-42b5a7e3a349"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#FFFBF5"
        }
      ],
      "expo-font",
      "expo-apple-authentication",
      "@react-native-community/datetimepicker",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Pawzr uses your location to show nearby pet lovers and calculate distances."
        }
      ],
      "@react-native-google-signin/google-signin"
    ]
  }
}
