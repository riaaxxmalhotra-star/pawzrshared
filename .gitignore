# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files (explicit list — NEVER use a blanket `.env.*` rule here,
# it would ignore the committed `.env.example` template)
.env
.env.local
.env*.local
.env.development
.env.preview
.env.production
.env.staging

# Credentials (NEVER commit these)
credentials.json
*.keystore
google-services.json
GoogleService-Info.plist
*-service-account.json
AuthKey_*.p8
/secrets/

# Build artifacts (NEVER commit these)
*.ipa
fastlane/report.xml

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android
